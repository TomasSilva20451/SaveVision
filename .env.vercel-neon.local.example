# Copiar para .env.vercel-neon.local (não commitar).
# DATABASE_URL = a mesma variável em Vercel → Settings → Environment Variables → Production.
# No savevision actual: base Neon "fintwin_staging" (confirmar nome em FINTWIN_EXPECTED_DATABASE no Vercel).
#
# Nunca coloques a palavra-passe real neste exemplo. O ficheiro .env.vercel-neon.local está no .gitignore.

# Só DATABASE_URL é obrigatório; FINTWIN_EXPECTED_DATABASE evita migrar a base errada por engano.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require
FINTWIN_EXPECTED_DATABASE=fintwin_staging
