# Cópia para .env.observability.local (gitignored): pnpm observability:setup

FINTWIN_PUBLIC_URL=http://127.0.0.1:3000
FINTWIN_METRICS_TOKEN=replace-with-long-random-token

# Alertas operacionais (Slack incoming webhook, n8n, etc.)
# FINTWIN_OPS_WEBHOOK_URL=https://hooks.slack.com/services/...

# OpenTelemetry (opcional; collector incluído em compose.observability.yml)
# FINTWIN_OTEL_ENABLED=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Loki local (stack docker)
FINTWIN_LOKI_URL=http://127.0.0.1:3100
