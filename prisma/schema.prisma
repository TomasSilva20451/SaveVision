// FinTwin — modelo de identidade e isolamento.
// Cada agregado financeiro futuro tem de carregar workspaceId.
// Um workspace conjunto não concede acesso aos workspaces pessoais.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  USER
  SUPPORT
  ADMIN
}

enum WorkspaceType {
  PERSONAL
  JOINT
}

enum WorkspaceRole {
  OWNER
  MEMBER
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DECLINED
  REMOVED
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  name            String
  passwordHash    String
  phone           String?
  birthDate       DateTime?  @db.Date
  avatarUrl       String?
  systemRole      SystemRole @default(USER)
  emailVerifiedAt DateTime?
  disabledAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  memberships             WorkspaceMember[]
  totpCredential          UserTotpCredential?
  recoveryCodes           RecoveryCode[]
  emailChallenges         EmailChallenge[]
  authSessions            AuthSession[]
  securityEvents          SecurityEvent[]
  passkeys                PasskeyCredential[]
  createdWorkspaces       Workspace[]               @relation("WorkspaceCreator")
  auditLogs               AuditLog[]                @relation("AuditActor")
  alertUserStates         FinancialAlertUserState[]
  monthlyReportNarratives MonthlyReportNarrative[]  @relation("MonthlyReportNarrativeAuthor")
  localAiSettings         UserLocalAiSettings?
  privacyConsents         PrivacyConsent[]
  erasureRequests         SubjectErasureRequest[]
  platformJobs            PlatformJob[]
}

enum PlatformJobKind {
  REPORT_EXPORT
  RECEIPT_OCR
  ML_CATEGORIZATION
}

enum PlatformJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Fila de trabalhos assíncronos. Não contém montantes nem documentos.
model PlatformJob {
  id            String            @id @default(cuid())
  workspaceId   String?
  requestedById String?
  kind          PlatformJobKind
  status        PlatformJobStatus @default(QUEUED)
  payload       Json
  result        Json?
  error         String?
  attempts      Int               @default(0)
  maxAttempts   Int               @default(3)
  lockedBy      String?
  lockedUntil   DateTime?
  availableAt   DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  finishedAt    DateTime?

  requestedBy User? @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([status, availableAt])
  @@index([kind, status])
  @@index([workspaceId])
}

/// Ledger de auditoria transversal. Não tem foreign keys deliberadamente:
/// eliminações operacionais nunca podem apagar a identidade histórica do evento.
model AuditEvent {
  sequence       BigInt   @id @default(autoincrement())
  id             String   @unique @default(cuid())
  occurredAt     DateTime @default(now())
  actorUserId    String?
  actorReference String
  workspaceId    String?
  action         String
  resourceType   String
  resourceId     String
  outcome        String
  source         String
  requestId      String?
  ipHash         String?
  userAgentHash  String?
  metadata       Json?
  previousHash   String
  eventHash      String   @unique
  signature      String
  signingKeyId   String

  @@index([workspaceId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
}

/// Uma tentativa de UPDATE/DELETE ao ledger é bloqueada por trigger e registada aqui.
model AuditTamperAttempt {
  id           String   @id
  detectedAt   DateTime @default(now())
  operation    String
  targetId     String?
  databaseUser String
  source       String

  @@index([detectedAt])
}

model UserLocalAiSettings {
  userId         String   @id
  localAiEnabled Boolean  @default(true)
  ollamaBaseUrl  String?  @db.VarChar(512)
  textModel      String?  @db.VarChar(128)
  imageModel     String?  @db.VarChar(128)
  helpModel      String?  @db.VarChar(128)
  storePrompts   Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Controlo operacional por capacidade ML. A variável de ambiente global continua
/// a ter precedência, para permitir um corte de emergência mesmo sem acesso à BD.
model MlFeatureControl {
  capability  String   @id
  enabled     Boolean  @default(true)
  killSwitch  Boolean  @default(false)
  reason      String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Telemetria mínima de uma execução ML. Não guarda dados financeiros em claro;
/// prompts só podem ser retidos, de forma truncada, após consentimento explícito.
/// Não existem foreign keys deliberadamente para preservar evidência operacional.
model MlInvocationEvent {
  id                  String   @id @default(cuid())
  workspaceId         String?
  userId              String?
  capability          String
  modelKey             String
  modelVersion         String
  promptKey            String
  promptVersion        String
  outcome              String
  latencyMs            Int
  estimatedInputTokens Int      @default(0)
  estimatedOutputTokens Int     @default(0)
  confidence           Float?
  inputHash            String
  outputHash           String?
  promptExcerpt        String?  @db.Text
  promptExpiresAt      DateTime?
  fallbackReason       String?
  humanReviewRequired  Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@index([capability, createdAt])
  @@index([workspaceId, createdAt])
  @@index([outcome, createdAt])
}

/// Resultado imutável de uma avaliação offline executada para um release.
model MlEvaluationRun {
  id               String    @id @default(cuid())
  suiteVersion     String
  releaseRef       String
  status           String
  metrics          Json
  datasetChecksums Json
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?

  @@index([status, startedAt])
  @@index([releaseRef])
}

/// Agregado periódico usado para sinalizar alterações de cobertura, confiança e
/// taxa de correção. É diagnóstico, nunca altera movimentos financeiros.
model MlDriftSnapshot {
  id             String   @id @default(cuid())
  workspaceId    String?
  capability     String
  periodKey      String
  sampleCount    Int
  coverage       Float
  meanConfidence Float?
  correctionRate Float?
  driftScore     Float?
  status         String
  createdAt      DateTime @default(now())

  @@index([capability, periodKey])
  @@index([workspaceId, createdAt])
}

model UserTotpCredential {
  userId           String    @id
  secretCiphertext String
  enabledAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model EmailChallenge {
  id         String    @id @default(cuid())
  userId     String
  email      String
  purpose    String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model AuthSession {
  id          String    @id @default(cuid())
  userId      String
  deviceLabel String
  userAgent   String?
  ipHash      String?
  deviceHash  String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model SecurityEvent {
  id         String   @id @default(cuid())
  userId     String?
  email      String?
  type       String
  ipHash     String?
  deviceHash String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PrivacyConsent {
  id             String   @id @default(cuid())
  userId         String
  consentKey     String
  version        String
  acceptedAt     DateTime @default(now())
  ipHash         String?
  userAgentHash  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentKey, version])
  @@index([userId, acceptedAt])
}

model SubjectErasureRequest {
  id             String    @id @default(cuid())
  userId         String
  status         String
  consentVersion String
  proofSha256    String?
  requestedAt    DateTime  @default(now())
  completedAt    DateTime?
  metadata       Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
}

model AuthRateBucket {
  key             String    @id
  failures        Int       @default(0)
  subjects        Json      @default("[]")
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt
}

/// Contadores de rate limit API (fallback PostgreSQL quando Redis indisponível).
model RateLimitCounter {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt
}

model PasskeyCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  transports   String?
  deviceLabel  String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WebAuthnChallenge {
  id        String   @id @default(cuid())
  userId    String?
  purpose   String
  challenge String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Workspace {
  id          String        @id @default(cuid())
  name        String
  type        WorkspaceType
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdBy                            User                                  @relation("WorkspaceCreator", fields: [createdById], references: [id])
  members                              WorkspaceMember[]
  accounts                             FinancialAccount[]
  categories                           Category[]
  transactions                         Transaction[]
  transfers                            Transfer[]
  auditLogs                            AuditLog[]
  incomeSeries                         IncomeSeries[]
  incomeOccurrences                    IncomeOccurrence[]
  ecommerceSales                       EcommerceSale[]
  tournamentIncomes                    TournamentIncome[]
  savingsGoals                         SavingsGoal[]
  savingsContributions                 SavingsGoalContribution[]
  planningSettings                     WorkspacePlanningSettings?
  cgdProducts                          CgdProductRegistry[]
  workspaceInvites                     WorkspaceInvite[]
  investmentPositions                  InvestmentPosition[]
  storedDocuments                      StoredDocument[]
  monthlyReportNarratives              MonthlyReportNarrative[]
  monthlyBudgets                       MonthlyBudget[]
  financialLiabilities                 FinancialLiability[]
  netWorthSnapshots                    NetWorthSnapshot[]
  financialAuditLogs                   FinancialAuditLog[]
  recurringExpenses                    RecurringExpense[]
  recurringExpenseOccurrences          RecurringExpenseOccurrence[]
  financialAlerts                      FinancialAlert[]
  transactionCategorizationRules       TransactionCategorizationRule[]
  categorizationSuggestions            TransactionCategorizationSuggestion[]
  recurringPatternSuggestionDismissals RecurringPatternSuggestionDismissal[]
  recurringPatternMerchantBlocks       RecurringPatternMerchantBlock[]
  openBankingConsents                  OpenBankingConsent[]
  bankFeedLines                        BankFeedLine[]
  bankReconciliationMatches            BankReconciliationMatch[]
  financialApprovals                   FinancialApproval[]
  webhookSubscriptions                 WebhookSubscription[]
  supportCases                         SupportCase[]

  @@index([type])
  @@index([createdById])
}

enum AccountType {
  CURRENT
  SAVINGS
  CASH
  INVESTMENT
  CRYPTO
  LIABILITY
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  EXPECTED
  COMPLETED
  CANCELLED
}

enum CategoryNature {
  NECESSARY
  DISCRETIONARY
}

enum CategoryBehavior {
  FIXED
  VARIABLE
}

enum IncomeSourceType {
  FAMILY_TRANSFER
  GIFT
  ECOMMERCE
  TENNIS_PRIZE
  SALARY
  FREELANCE
  REFUND
  INTEREST
  OTHER
}

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
  CUSTOM
  ONE_OFF
}

enum RecurringExpenseStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum RecurringExpenseOccurrenceStatus {
  EXPECTED
  PAID
  SKIPPED
  POSTPONED
  CANCELLED
}

enum IncomeOccurrenceStatus {
  EXPECTED
  RECEIVED
  MISSED
  CANCELLED
}

enum IncomeCertainty {
  HIGH
  MEDIUM
  LOW
}

model FinancialAccount {
  id                   String      @id @default(cuid())
  workspaceId          String
  ownerUserId          String?
  name                 String
  institution          String?
  type                 AccountType
  currency             String      @default("EUR")
  openingBalance       Decimal     @default(0) @db.Decimal(19, 4)
  isIncludedInNetWorth Boolean     @default(true)
  isArchived           Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions        Transaction[]
  incomeSeries        IncomeSeries[]
  incomeOccurrences   IncomeOccurrence[]
  ecommerceSales      EcommerceSale[]
  tournamentIncomes   TournamentIncome[]
  savingsGoals        SavingsGoal[]
  investmentPositions InvestmentPosition[]
  liabilityPayments   LiabilityPayment[]
  recurringExpenses   RecurringExpense[]
  openBankingConsents OpenBankingConsent[]
  bankFeedLines       BankFeedLine[]

  @@index([workspaceId, isArchived])
}

model Category {
  id          String           @id @default(cuid())
  workspaceId String
  name        String
  nature      CategoryNature   @default(NECESSARY)
  behavior    CategoryBehavior @default(VARIABLE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace                      Workspace                             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions                   Transaction[]
  budgetLines                    BudgetLine[]
  recurringExpenses              RecurringExpense[]
  transactionCategorizationRules TransactionCategorizationRule[]
  categorizationSuggestions      TransactionCategorizationSuggestion[]

  @@unique([workspaceId, name])
}

model TransactionCategorizationRule {
  id                    String          @id @default(cuid())
  workspaceId           String
  pattern               String
  merchant              String
  categoryId            String?
  transactionType       TransactionType
  nature                CategoryNature?
  appliedCount          Int             @default(1)
  correctionCount       Int             @default(0)
  lastConfirmedByUserId String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, pattern, transactionType])
  @@index([workspaceId, updatedAt])
}

enum CategorizationSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CategorizationSuggestionSource {
  RULE
  OLLAMA
}

model TransactionCategorizationSuggestion {
  id                  String                         @id @default(cuid())
  workspaceId         String
  transactionId       String                         @unique
  suggestedCategoryId String?
  suggestedMerchant   String
  confidence          Float
  source              CategorizationSuggestionSource
  provider            String
  status              CategorizationSuggestionStatus @default(PENDING)
  rejectedUntil       DateTime?
  computedAt          DateTime                       @default(now())
  decidedAt           DateTime?
  decidedByUserId     String?

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [suggestedCategoryId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, computedAt])
}

model RecurringPatternSuggestionDismissal {
  id                String   @id @default(cuid())
  workspaceId       String
  suggestionKey     String
  merchantPattern   String
  dismissedByUserId String
  createdAt         DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, suggestionKey])
  @@index([workspaceId, merchantPattern])
}

model RecurringPatternMerchantBlock {
  id              String   @id @default(cuid())
  workspaceId     String
  merchantPattern String
  blockedByUserId String
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, merchantPattern])
}

model Transfer {
  id              String   @id @default(cuid())
  workspaceId     String
  fromAccountId   String
  toAccountId     String
  amount          Decimal  @db.Decimal(19, 4)
  currency        String   @default("EUR")
  occurredAt      DateTime
  description     String?
  createdByUserId String
  createdAt       DateTime @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([workspaceId, occurredAt])
}

model Transaction {
  id          String            @id @default(cuid())
  workspaceId String
  accountId   String
  userId      String
  type        TransactionType
  status      TransactionStatus @default(COMPLETED)
  amount      Decimal           @db.Decimal(19, 4)
  currency    String            @default("EUR")
  occurredAt  DateTime
  description String?
  categoryId  String?
  notes       String?
  transferId  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category  Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transfer  Transfer?        @relation(fields: [transferId], references: [id], onDelete: SetNull)

  incomeOccurrence           IncomeOccurrence?
  ecommerceSale              EcommerceSale?
  tournamentIncome           TournamentIncome?
  liabilityPrincipalPayment  LiabilityPayment?                    @relation("LiabilityPrincipalTx")
  liabilityExpensePayment    LiabilityPayment?                    @relation("LiabilityExpenseTx")
  recurringExpenseOccurrence RecurringExpenseOccurrence?
  categorizationSuggestion   TransactionCategorizationSuggestion?
  bankReconciliationMatch    BankReconciliationMatch?

  @@index([workspaceId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([workspaceId, type, status])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  workspaceId String
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  actor     User      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model IncomeSeries {
  id           String             @id @default(cuid())
  workspaceId  String
  userId       String
  sourceType   IncomeSourceType
  title        String
  amount       Decimal            @db.Decimal(19, 4)
  frequency    RecurringFrequency
  accountId    String
  familyOrigin String?
  certainty    IncomeCertainty?
  nextDueAt    DateTime?
  endAt        DateTime?
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     FinancialAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  occurrences IncomeOccurrence[]

  @@index([workspaceId, active])
}

model IncomeOccurrence {
  id             String                 @id @default(cuid())
  workspaceId    String
  userId         String
  seriesId       String?
  sourceType     IncomeSourceType
  status         IncomeOccurrenceStatus @default(EXPECTED)
  expectedAmount Decimal                @db.Decimal(19, 4)
  scheduledFor   DateTime
  accountId      String
  title          String
  transactionId  String?                @unique
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  series      IncomeSeries?    @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transaction Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, scheduledFor, status])
  @@index([seriesId])
}

model RecurringExpense {
  id                String                 @id @default(cuid())
  workspaceId       String
  userId            String
  name              String
  description       String?
  categoryId        String
  expectedAmount    Decimal                @db.Decimal(19, 4)
  frequency         RecurringFrequency
  startDate         DateTime
  endDate           DateTime?
  dueDayOfMonth     Int?
  accountId         String?
  linkedLiabilityId String?
  status            RecurringExpenseStatus @default(ACTIVE)
  pausedAt          DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  workspace       Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category        Category                     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account         FinancialAccount?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  linkedLiability FinancialLiability?          @relation(fields: [linkedLiabilityId], references: [id], onDelete: SetNull)
  occurrences     RecurringExpenseOccurrence[]

  @@index([workspaceId, status])
  @@index([workspaceId, linkedLiabilityId])
}

model RecurringExpenseOccurrence {
  id                       String                           @id @default(cuid())
  workspaceId              String
  recurringExpenseId       String
  anchorDate               DateTime
  dueDate                  DateTime
  expectedAmount           Decimal                          @db.Decimal(19, 4)
  actualAmount             Decimal?                         @db.Decimal(19, 4)
  status                   RecurringExpenseOccurrenceStatus @default(EXPECTED)
  paidAt                   DateTime?
  transactionId            String?                          @unique
  idempotencyKey           String?
  expectedAmountCustomized Boolean                          @default(false)
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recurringExpense RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)
  transaction      Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([recurringExpenseId, anchorDate])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, dueDate, status])
  @@index([recurringExpenseId, status])
}

model EcommerceSale {
  id                   String    @id @default(cuid())
  workspaceId          String
  userId               String
  accountId            String
  marketplace          String?
  orderReference       String?
  grossAmount          Decimal   @db.Decimal(19, 4)
  marketplaceFees      Decimal   @default(0) @db.Decimal(19, 4)
  paymentFees          Decimal   @default(0) @db.Decimal(19, 4)
  shippingCost         Decimal   @default(0) @db.Decimal(19, 4)
  costOfGoods          Decimal   @default(0) @db.Decimal(19, 4)
  otherCosts           Decimal   @default(0) @db.Decimal(19, 4)
  netProceeds          Decimal   @db.Decimal(19, 4)
  taxReservePercentage Decimal   @default(0) @db.Decimal(7, 4)
  taxReserveAmount     Decimal   @default(0) @db.Decimal(19, 4)
  saleDate             DateTime
  payoutDate           DateTime?
  notes                String?
  transactionId        String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transaction Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, saleDate])
}

model TournamentIncome {
  id                String   @id @default(cuid())
  workspaceId       String
  userId            String
  accountId         String
  tournamentName    String
  tournamentDate    DateTime
  location          String?
  category          String?
  placement         String?
  grossPrize        Decimal  @db.Decimal(19, 4)
  registrationFee   Decimal  @default(0) @db.Decimal(19, 4)
  travelCost        Decimal  @default(0) @db.Decimal(19, 4)
  accommodationCost Decimal  @default(0) @db.Decimal(19, 4)
  foodCost          Decimal  @default(0) @db.Decimal(19, 4)
  otherCosts        Decimal  @default(0) @db.Decimal(19, 4)
  netPrize          Decimal  @db.Decimal(19, 4)
  notes             String?
  transactionId     String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transaction Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, tournamentDate])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole
  status      MembershipStatus
  joinedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId, status])
}

enum OpenBankingConsentStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

/// Consentimento read-only (sem débitos). Integração real fica atrás de OpenBankingProvider.
model OpenBankingConsent {
  id          String                   @id @default(cuid())
  workspaceId String
  accountId   String
  provider    String
  consentRef  String
  status      OpenBankingConsentStatus @default(PENDING)
  scopes      String[]                 @default(["accounts:read", "transactions:read"])
  readOnly    Boolean                  @default(true)
  grantedAt   DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, accountId, provider])
  @@index([workspaceId, status])
}

enum BankFeedLineStatus {
  UNMATCHED
  MATCHED
  IGNORED
  DUPLICATE
}

/// Movimento importado do banco (Open Banking ou CSV). Montante com sinal contabilístico.
model BankFeedLine {
  id              String             @id @default(cuid())
  workspaceId     String
  accountId       String
  externalId      String
  bookingDate     DateTime
  amount          Decimal            @db.Decimal(19, 4)
  currency        String             @default("EUR")
  description     String?
  counterpartyHash String?
  status          BankFeedLineStatus @default(UNMATCHED)
  importedAt      DateTime           @default(now())
  duplicateOfId   String?

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  duplicateOf BankFeedLine?    @relation("BankFeedDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  BankFeedLine[]   @relation("BankFeedDuplicate")
  match       BankReconciliationMatch?

  @@unique([workspaceId, externalId])
  @@index([workspaceId, accountId, status, bookingDate])
}

enum ReconciliationMatchMethod {
  AUTO
  MANUAL
}

model BankReconciliationMatch {
  id              String                    @id @default(cuid())
  workspaceId     String
  bankFeedLineId  String                    @unique
  transactionId   String                    @unique
  matchedByUserId String?
  matchedAt       DateTime                  @default(now())
  confidence      Float
  method          ReconciliationMatchMethod

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bankFeedLine  BankFeedLine     @relation(fields: [bankFeedLineId], references: [id], onDelete: Cascade)
  transaction   Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, matchedAt])
}

enum FinancialApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Maker-checker: o revisor tem de ser distinto do solicitante.
model FinancialApproval {
  id            String                  @id @default(cuid())
  workspaceId   String
  requestedById String
  reviewedById  String?
  status        FinancialApprovalStatus @default(PENDING)
  actionType    String
  entityType    String
  entityId      String
  payload       Json
  reviewNote    String?
  createdAt     DateTime                @default(now())
  reviewedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
}

model WebhookSubscription {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  secretHash  String
  secretEnc   String?
  events      String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
}

enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportCase {
  id          String            @id @default(cuid())
  workspaceId String
  userId      String
  subject     String
  status      SupportCaseStatus @default(OPEN)
  disputeRef  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  resolvedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
}

enum SavingsGoalKind {
  GENERAL
  EMERGENCY_FUND
}

model SavingsGoal {
  id           String          @id @default(cuid())
  workspaceId  String
  userId       String
  title        String
  kind         SavingsGoalKind @default(GENERAL)
  targetAmount Decimal         @db.Decimal(19, 4)
  targetDate   DateTime?
  accountId    String?
  notes        String?
  archived     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  workspace     Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account       FinancialAccount?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
