  SAVINGS
  INVESTMENT
  OTHER
}

model CgdProductRegistry {
  id          String             @id @default(cuid())
  workspaceId String
  userId      String
  label       String
  category    CgdProductCategory @default(OTHER)
  reference   String?
  notes       String?
  createdAt   DateTime           @default(now())
