model SavingsGoalContribution {
  id            String   @id @default(cuid())
  workspaceId   String
  goalId        String
  userId        String
  amount        Decimal  @db.Decimal(19, 4)
  contributedAt DateTime
  notes         String?
  createdAt     DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal      SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, contributedAt])
}

model WorkspacePlanningSettings {
  workspaceId               String   @id
  emergencyFundTargetMonths Int      @default(6)
  monthlyEssentialExpenses  Decimal? @db.Decimal(19, 4)
  updatedAt                 DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum CgdProductCategory {
