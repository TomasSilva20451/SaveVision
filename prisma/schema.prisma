enum DocumentIntegrityStatus {
  OK
  UNAVAILABLE
}

model StoredDocument {
  id                String                   @id @default(cuid())
  workspaceId       String
  userId            String
  originalName      String
  mimeType          String
  sizeBytes         Int
  storageKey        String                   @unique
  sha256            String
  integrityStatus   DocumentIntegrityStatus  @default(OK)
  integrityReason   String?
  integrityCheckedAt DateTime?
  createdAt         DateTime                 @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([integrityStatus])
}

model MonthlyReportNarrative {
  id              String   @id @default(cuid())
  workspaceId     String
  periodKey       String
  promptVersion   String
  model           String
  sourceFactsJson Json
  narrativeText   String
  generatedById   String
  generatedAt     DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generatedBy User      @relation("MonthlyReportNarrativeAuthor", fields: [generatedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, periodKey, generatedAt])
}

model MonthlyBudget {
  id          String   @id @default(cuid())
  workspaceId String
  year        Int
  month       Int
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lines     BudgetLine[]

  @@unique([workspaceId, year, month])
  @@index([workspaceId, year, month])
}

model BudgetLine {
  id              String  @id @default(cuid())
  monthlyBudgetId String
  categoryId      String
  limitAmount     Decimal @db.Decimal(19, 4)

  monthlyBudget MonthlyBudget @relation(fields: [monthlyBudgetId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([monthlyBudgetId, categoryId])
}

enum LiabilityType {
  PERSONAL_LOAN
  AUTO_LOAN
  MORTGAGE
  FAMILY_LOAN
  OTHER
}

model FinancialLiability {
  id                   String        @id @default(cuid())
  workspaceId          String
  userId               String
  title                String
  type                 LiabilityType @default(OTHER)
  outstandingBalance   Decimal       @db.Decimal(19, 4)
  monthlyPayment       Decimal?      @db.Decimal(19, 4)
  manualRatePercent    Decimal?      @db.Decimal(7, 4)
  paymentDueDayOfMonth Int?
  currency             String        @default("EUR")
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  workspace               Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payments                LiabilityPayment[]
  linkedRecurringExpenses RecurringExpense[]

  @@index([workspaceId])
}

model LiabilityPayment {
  id                     String   @id @default(cuid())
  workspaceId            String
  liabilityId            String
  userId                 String
  paidAt                 DateTime
  principalAmount        Decimal  @default(0) @db.Decimal(19, 4)
  interestAmount         Decimal  @default(0) @db.Decimal(19, 4)
  feesAmount             Decimal  @default(0) @db.Decimal(19, 4)
  accountId              String?
  principalTransactionId String?  @unique
  expenseTransactionId   String?  @unique
  idempotencyKey         String?
  notes                  String?
  createdAt              DateTime @default(now())

  liability            FinancialLiability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)
  account              FinancialAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  principalTransaction Transaction?       @relation("LiabilityPrincipalTx", fields: [principalTransactionId], references: [id], onDelete: SetNull)
  expenseTransaction   Transaction?       @relation("LiabilityExpenseTx", fields: [expenseTransactionId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, idempotencyKey])
  @@index([liabilityId, paidAt])
}

model NetWorthSnapshot {
  id                 String   @id @default(cuid())
  workspaceId        String
  userId             String
  asOfDate           DateTime
  cashTotal          Decimal  @db.Decimal(19, 4)
  savingsTotal       Decimal  @db.Decimal(19, 4)
  investmentsTotal   Decimal  @db.Decimal(19, 4)
  manualAssetsTotal  Decimal  @default(0) @db.Decimal(19, 4)
  liabilitiesTotal   Decimal  @db.Decimal(19, 4)
  netWorth           Decimal  @db.Decimal(19, 4)
  calculationVersion Int      @default(1)
  createdAt          DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, asOfDate])
}

enum FinancialAuditAction {
  ACCOUNT_CREATED
  ACCOUNT_ARCHIVED
  TRANSACTION_CREATED
  INCOME_CONFIRMED
  BUDGET_CHANGED
  LIABILITY_CREATED
  LIABILITY_PAYMENT_RECORDED
  NET_WORTH_SNAPSHOT_CREATED
  INVESTMENT_CHANGED
  RECURRENT_EXPENSE_CREATED
  RECURRENT_EXPENSE_UPDATED
  RECURRENT_EXPENSE_PAUSED
  RECURRENT_EXPENSE_RESUMED
  RECURRENT_EXPENSE_ENDED
  EXPENSE_OCCURRENCE_PAID
  EXPENSE_OCCURRENCE_PAYMENT_REVERSED
  EXPENSE_OCCURRENCE_SKIPPED
  EXPENSE_OCCURRENCE_POSTPONED
}

model FinancialAuditLog {
  id          String               @id @default(cuid())
  workspaceId String
  actorUserId String
  action      FinancialAuditAction
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime             @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}

enum FinancialAlertSeverity {
  INFO
  ATTENTION
  HIGH
  CRITICAL
}

enum FinancialAlertStatus {
  ACTIVE
  RESOLVED
}

enum FinancialAlertType {
  LOW_PROJECTED_BALANCE
  NEGATIVE_PROJECTED_BALANCE
  BUDGET_NEAR_LIMIT
  BUDGET_EXCEEDED
  RECURRING_EXPENSE_DUE
  RECURRING_EXPENSE_OVERDUE
  EXPECTED_INCOME_OVERDUE
  UNUSUAL_EXPENSE
  EMERGENCY_FUND_BELOW_TARGET
  RECURRING_LIABILITY_CONFIGURATION
  DUPLICATE_PAYMENT_RISK
}

model FinancialAlert {
  id               String                 @id @default(cuid())
  workspaceId      String
  type             FinancialAlertType
  severity         FinancialAlertSeverity
  title            String
  description      String
  status           FinancialAlertStatus   @default(ACTIVE)
  deduplicationKey String
  sourceType       String?
  sourceId         String?
  periodStart      DateTime?
  periodEnd        DateTime?
  evidence         Json?
  actionUrl        String?
  detectedAt       DateTime               @default(now())
  lastEvaluatedAt  DateTime               @default(now())
  resolvedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  workspace  Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userStates FinancialAlertUserState[]

  @@unique([workspaceId, deduplicationKey])
  @@index([workspaceId, status, severity])
}

model FinancialAlertUserState {
  id          String    @id @default(cuid())
  alertId     String
  userId      String
  seenAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  alert FinancialAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([alertId, userId])
  @@index([userId, dismissedAt])
}
