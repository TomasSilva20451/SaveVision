FINTWIN_ENV=production
FINTWIN_EXPECTED_DATABASE=fintwin_live
APP_NAME=FinTwin
# Apenas caminhos lidos pelo Docker Compose/deploy; nunca guardar os valores aqui.
FINTWIN_DATABASE_URL_SECRET_FILE=/etc/fintwin/production/database-url
FINTWIN_AUTH_SECRET_FILE=/etc/fintwin/production/auth-secret
FINTWIN_DOCUMENT_KEY_SECRET_FILE=/etc/fintwin/production/document-key
FINTWIN_AUDIT_KEY_SECRET_FILE=/etc/fintwin/production/audit-key
FINTWIN_DOCUMENT_ENCRYPTION_KEY_ID=production-documents-v1
FINTWIN_AUDIT_SIGNING_KEY_ID=production-audit-v1
FINTWIN_PUBLIC_URL=https://fintwin.example
FINTWIN_ENFORCE_TLS=1
FINTWIN_REQUIRE_ENCRYPTED_DOCUMENTS=1
FINTWIN_AUDIT_ARCHIVE_REQUIRED=1
FINTWIN_IMAGE=ghcr.io/owner/fintwin:sha-replace
FINTWIN_PORT=3000
FINTWIN_LOCAL_AI_ENABLED=0

# Observabilidade (mesmo token que pnpm observability:setup → secrets/prometheus_metrics_token)
# FINTWIN_METRICS_TOKEN=
# FINTWIN_OTEL_ENABLED=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318

# ClamAV (sidecar clamav-production no compose.deploy.yml)
# FINTWIN_CLAMAV_ENABLED=1
# FINTWIN_CLAMAV_HOST=clamav-production
