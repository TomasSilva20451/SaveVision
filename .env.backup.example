# Cópia para .env.backup.local (gitignored): pnpm backup:setup
# Usado por pnpm db:backup:run e pelo cron instalado com pnpm backup:install-cron

# Base a fazer dump (development local por omissão; produção: copiar DATABASE_URL de .env.production.local)
DATABASE_URL=postgresql://fintwin:fintwin@localhost:5433/fintwin?schema=public
FINTWIN_ENV=development

# O .env guarda apenas o caminho. O valor fica num ficheiro 0600/cofre.
FINTWIN_BACKUP_ENCRYPTION_SECRET_FILE=storage/secrets/backup-encryption-key
FINTWIN_BACKUP_ENCRYPTION_KEY_ID=development-backup-v1

# Cifrar e remover .dump em claro após upload (recomendado em produção)
FINTWIN_BACKUP_DELETE_PLAINTEXT=yes

FINTWIN_BACKUP_RETENTION_DAYS=30

# Off-site via rclone (wrapper abaixo). Requer: rclone config create <remote> ...
FINTWIN_RCLONE_REMOTE=fintwin-offsite
FINTWIN_RCLONE_PREFIX=fintwin/backups
FINTWIN_BACKUP_OFFSITE_COMMAND='bash scripts/backup-offsite-rclone.sh "$FILE"'
# Config rclone do projecto (gitignored); omissão em scripts/backup-offsite-rclone.sh
# RCLONE_CONFIG=.rclone.conf
