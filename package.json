{
  "name": "fintwin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "dev:demo": "FINTWIN_ENV=demo DATABASE_URL=postgresql://fintwin:fintwin@localhost:5433/fintwin_demo_ui?schema=public next dev",
    "db:demo-ui": "bash scripts/db-demo-ui-setup.sh",
    "db:e2e": "bash scripts/db-e2e-setup.sh",
    "audit:screenshots": "node scripts/capture-visual-audit.mjs",
    "build": "next build --webpack",
    "build:production": "NEXT_DIST_DIR=.next-production next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "gate": "pnpm lint && pnpm typecheck && pnpm test:config && pnpm ml:eval && pnpm test && pnpm build",
    "ci:verify": "node scripts/verify-reproducible.mjs",
    "ml:eval": "tsx scripts/ml-eval.ts",
    "ml:eval:record": "FINTWIN_ML_EVAL_PERSIST=1 tsx scripts/ml-eval.ts",
    "ml:retention": "tsx scripts/ml-retention.ts",
    "env:check": "node scripts/validate-environment.mjs",
    "test:e2e:strict": "CI=1 playwright test --retries=0",
    "test": "vitest run",
    "test:config": "node --test scripts/environment-policy.test.mjs scripts/backup-policy.test.mjs scripts/secret-files.test.mjs",
    "audit:verify": "tsx scripts/verify-audit-ledger.ts",
    "documents:integrity:check": "tsx scripts/documents-integrity-check.ts",
    "documents:integrity:repair": "tsx scripts/documents-integrity-check.ts --apply",
    "test:e2e": "pnpm build && FINTWIN_E2E_PRODUCTION=1 playwright test",
    "test:e2e:ci": "pnpm build && CI=1 playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:production:setup": "node scripts/db-production-setup.mjs",
    "start:production": "node scripts/start-production-local.mjs",
    "db:seed": "prisma db seed",
    "db:seed:demo": "FINTWIN_ENV=demo FINTWIN_SEED_PROFILE=demo prisma db seed",
    "db:seed:e2e": "FINTWIN_ENV=e2e FINTWIN_SEED_PROFILE=e2e prisma db seed",
    "db:deploy:staging": "node scripts/deploy-database.mjs staging",
    "db:deploy:production": "node scripts/deploy-database.mjs production",
    "deploy:staging": "pnpm ci:verify && node scripts/deploy-application.mjs staging",
    "deploy:production": "pnpm ci:verify && node scripts/deploy-application.mjs production",
    "db:backup": "bash scripts/db-backup.sh",
    "backup:setup": "node scripts/setup-backup-operations.mjs",
    "backup:install-cron": "bash scripts/install-backup-cron.sh",
    "db:backup:run": "bash scripts/backup-cron-entrypoint.sh",
    "db:backup:drill": "node scripts/backup-restore-drill.mjs",
    "db:pitr:base": "bash scripts/pitr-base-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "observability:setup": "node scripts/setup-observability-operations.mjs",
    "observability:up": "bash scripts/observability-up.sh",
    "observability:down": "docker compose -f compose.observability.yml down",
    "observability:install-cron": "bash scripts/install-ops-alert-cron.sh",
    "ops:alert-check": "bash scripts/ops-alert-entrypoint.sh",
    "security:audit": "node scripts/security-audit.mjs",
    "security:sbom": "node scripts/generate-sbom.mjs",
    "security:setup-dast-url": "node scripts/setup-github-dast-variable.mjs",
    "security:pentest-check": "node scripts/pentest-readiness-check.mjs",
    "security:dast-compare": "node scripts/dast-compare-baseline.mjs",
    "infra:render-staging-secrets": "node scripts/render-staging-secrets-from-aws.mjs",
    "infra:terraform-checklist": "node scripts/terraform-staging-checklist.mjs",
    "load:smoke": "node scripts/run-k6-smoke.mjs",
    "game-day:drill": "node scripts/game-day-drill.mjs",
    "audit:worm:sync": "node scripts/audit-worm-sync.mjs",
    "siem:ping": "node scripts/siem-forward.mjs",
    "jobs:work": "tsx scripts/platform-jobs-worker.ts",
    "deploy:rollout-check": "node scripts/deploy-rollout.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "argon2": "^0.45.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.6",
    "ioredis": "^5.11.1",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-qr-code": "^2.2.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cyclonedx/cdxgen": "^11.11.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "overrides": {
      "lodash": ">=4.18.0",
      "deepmerge-ts": ">=8.0.0",
      "mysql2": ">=3.23.1",
      "fast-uri": ">=3.1.9",
      "body-parser": ">=2.4.0",
      "tar": ">=7.5.19",
      "jsonata": ">=2.2.1"
    }
  }
}
