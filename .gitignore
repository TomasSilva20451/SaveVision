# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright/.auth/
/test-results/
/storage/backups/

# next.js
/.next/
/.next-ml-governance/
/.next-production/
/.next-production-*/
/out/

# production
/build
/dist/sbom

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example
!.env.*.example
.rclone.conf
/secrets/
!/secrets/fly/
/secrets/fly/**
!/secrets/fly/*.template

# uploads stay outside public/
/storage
!/storage/evidence/
/storage/evidence/**
!/storage/evidence/README.md
!/storage/evidence/**/.gitkeep

# vercel
.vercel
.env.smtp.local

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma Client gerado
/src/generated

/src/generated/prisma
