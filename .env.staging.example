FINTWIN_ENV=staging
FINTWIN_EXPECTED_DATABASE=fintwin_staging
APP_NAME=FinTwin Staging
FINTWIN_DATABASE_URL_SECRET_FILE=/etc/fintwin/staging/database-url
FINTWIN_AUTH_SECRET_FILE=/etc/fintwin/staging/auth-secret
FINTWIN_DOCUMENT_KEY_SECRET_FILE=/etc/fintwin/staging/document-key
FINTWIN_AUDIT_KEY_SECRET_FILE=/etc/fintwin/staging/audit-key
FINTWIN_DOCUMENT_ENCRYPTION_KEY_ID=staging-documents-v1
FINTWIN_AUDIT_SIGNING_KEY_ID=staging-audit-v1
FINTWIN_PUBLIC_URL=https://staging.fintwin.example
FINTWIN_ENFORCE_TLS=1
FINTWIN_REQUIRE_ENCRYPTED_DOCUMENTS=1
FINTWIN_AUDIT_ARCHIVE_REQUIRED=1
FINTWIN_IMAGE=ghcr.io/owner/fintwin:sha-replace
FINTWIN_PORT=3001
FINTWIN_LOCAL_AI_ENABLED=0

# Redis rate limit (Terraform staging enable_redis=true): segredo fintwin/staging/redis-url
# FINTWIN_REDIS_URL=redis://<elasticache-host>:6379
# DAST (GitHub Actions): pnpm security:setup-dast-url $FINTWIN_PUBLIC_URL
# ClamAV: sidecar compose.deploy.yml (omissão activo)
# FINTWIN_CLAMAV_ENABLED=1
# FINTWIN_CLAMAV_HOST=clamav-staging
