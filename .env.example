APP_NAME=FinTwin
FINTWIN_ENV=development
# Base principal (dados persistentes; não usar para E2E)
DATABASE_URL=postgresql://fintwin:fintwin@localhost:5433/fintwin?schema=public
# Opcional: protege a base principal na política de limpeza E2E
FINTWIN_PRIMARY_DATABASE_URL=postgresql://fintwin:fintwin@localhost:5433/fintwin?schema=public
# Demonstração visual limpa: pnpm db:demo-ui && pnpm dev:demo
# FINTWIN_DEMO_UI_DATABASE=fintwin_demo_ui
# Playwright (.env.e2e): fintwin_e2e — ver scripts/db-e2e-setup.sh
# Apenas desenvolvimento local. Em staging/produção usar AUTH_SECRET_FILE
# apontando para um secret manager/ficheiro montado, nunca guardar o valor no .env.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Cifra documental e ledger forense (desenvolvimento pode usar os fallbacks locais).
# Produção exige os quatro valores via ficheiros montados e IDs próprios do ambiente:
# FINTWIN_DOCUMENT_ENCRYPTION_KEY_FILE=/run/secrets/fintwin_document_key
# FINTWIN_DOCUMENT_ENCRYPTION_KEY_ID=production-documents-v1
# FINTWIN_AUDIT_SIGNING_KEY_FILE=/run/secrets/fintwin_audit_key
# FINTWIN_AUDIT_SIGNING_KEY_ID=production-audit-v1
# FINTWIN_REQUIRE_ENCRYPTED_DOCUMENTS=1
# FINTWIN_AUDIT_ARCHIVE_REQUIRED=1

# Categorização local, deteção de recorrências e assistente financeiro (sem cloud)
FINTWIN_LOCAL_AI_ENABLED=1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TRANSACTION_MODEL=qwen3.5:4b-mlx
# Ajuda contextual (/perfil/ia, botão ?)
# OLLAMA_HELP_MODEL=qwen2.5-coder:7b
# Recibos (visão local: Moondream + fallback qwen3.5 visão)
# OLLAMA_RECEIPT_MODEL=moondream:latest
# OLLAMA_RECEIPT_FALLBACK_MODEL=qwen3.5:4b-mlx
# Resumo narrativo mensal em /relatorios
# OLLAMA_REPORT_MODEL=gemma3:4b
# Opcional: explicações de alertas/insights (omissão: OLLAMA_TRANSACTION_MODEL)
# OLLAMA_EXPLANATION_MODEL=gemma3:4b
# Por omissão, endpoints Ollama remotos são recusados. Só ativar conscientemente.
# OLLAMA_ALLOW_REMOTE=1
# Corte de emergência global ou por capacidade (lista separada por vírgulas).
# Ex.: all ou transaction-categorization,financial-assistant-intent
# FINTWIN_ML_KILL_SWITCH=
# Releases persistem o resultado com FINTWIN_ML_EVAL_PERSIST=1; não ativar em evals locais descartáveis.

# Bootstrap local/privado de produção (sem dados financeiros fictícios)
# Copiar para .env.production.local, preencher palavras-passe fortes e executar:
# pnpm db:production:setup
# FINTWIN_PRODUCTION_BOOTSTRAP=yes
# FINTWIN_TOMAS_EMAIL=tomas@fintwin.local
# FINTWIN_TOMAS_PASSWORD=replace-with-at-least-14-characters
# FINTWIN_TELMO_EMAIL=telmo@fintwin.local
# FINTWIN_TELMO_PASSWORD=replace-with-at-least-14-characters

# Backups cifrados, off-site e continuidade (docs/BUSINESS_CONTINUITY.md)
# FINTWIN_BACKUP_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters
# FINTWIN_BACKUP_OFFSITE_COMMAND=rclone copy $FILE remote:fintwin-backups/
# FINTWIN_BACKUP_RETENTION_DAYS=30
# FINTWIN_BACKUP_DELETE_PLAINTEXT=yes
# FINTWIN_BACKUP_DRILL=yes

# Observabilidade (docs/OBSERVABILITY.md)
# FINTWIN_OTEL_ENABLED=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=fintwin
# FINTWIN_METRICS_TOKEN=replace-with-long-random-token
# FINTWIN_OPS_WEBHOOK_URL=https://hooks.example/ops
# FINTWIN_PUBLIC_URL=http://127.0.0.1:3000

# Email transaccional (verificação, recuperação, alertas CRITICAL/HIGH e plano poupança)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="FinTwin <noreply@example.com>"
# AUTH_URL=https://app.example.com
# FINTWIN_EMAIL_DEV_LINKS=1

# Uploads: ClamAV opcional (produção recomendado)
# FINTWIN_CLAMAV_ENABLED=1
# FINTWIN_CLAMAV_BIN=clamscan
# FINTWIN_CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
