# Dependabot corre pnpm install ao actualizar o lockfile. Com minimumReleaseAge activo
# (omissão recente do pnpm/ambiente GH), eslint-config-next@16.4.3 falha porque a versão
# foi publicada horas depois do instante de resolução — ver update #1652320396.
minimum-release-age-exclude[]=eslint-config-next
minimum-release-age-exclude[]=next
minimum-release-age-exclude[]=@next/eslint-plugin-next
