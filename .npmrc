# Dependabot corre `pnpm update … --config.minimum-release-age=4320` ao actualizar o lockfile.
# Versões publicadas horas depois do instante simulado falham com ERR_PNPM_NO_MATCHING_VERSION
# (ver GH update #1652353497). Exclusões alinhadas com pnpm-workspace.yaml.
minimum-release-age-exclude[]=next
minimum-release-age-exclude[]=eslint-config-next
minimum-release-age-exclude[]=@next/env
minimum-release-age-exclude[]=@next/eslint-plugin-next
minimum-release-age-exclude[]=@next/*
minimum-release-age-exclude[]=@appthreat/*
minimum-release-age-exclude[]=@cyclonedx/*
minimum-release-age-exclude[]=@babel/*
